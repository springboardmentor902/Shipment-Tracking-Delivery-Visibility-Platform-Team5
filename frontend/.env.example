# Optional. If set, LiveMap renders a real Google Map with the planned route drawn as a
# line and a live-updating driver marker. This must be a BROWSER key (restricted by HTTP
# referrer in the Google Cloud Console, with the Maps JavaScript API + Directions API
# enabled) - it is safe to expose in client code, unlike the backend's server-side
# GOOGLE_MAPS_API_KEY. If unset, LiveMap falls back to a schematic (non-map) view instead
# of breaking.
VITE_GOOGLE_MAPS_API_KEY=
